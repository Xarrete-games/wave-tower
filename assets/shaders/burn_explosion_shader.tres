[resource]
code = "shader_type canvas_item;
render_mode blend_mix, unshaded;

uniform sampler2D Dissolver_texture : source_color, repeat_enable;
uniform sampler2D Flame_texture : source_color, repeat_enable;



void fragment() {
// Input:8
	vec4 n_out8p0 = COLOR;
	float n_out8p4 = n_out8p0.a;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Dissolver_texture, UV);
	float n_out3p1 = n_out3p0.r;


// SmoothStep:4
	float n_in4p1 = 1.00000;
	float n_out4p0 = smoothstep(n_out8p4, n_in4p1, n_out3p1);


	vec4 n_out7p0;
// Texture2D:7
	n_out7p0 = texture(Flame_texture, UV);
	float n_out7p1 = n_out7p0.r;


// FloatOp:5
	float n_out5p0 = n_out4p0 * n_out7p1;


// Output:0
	COLOR.rgb = vec3(n_out8p0.xyz);
	COLOR.a = n_out5p0;


}
"
