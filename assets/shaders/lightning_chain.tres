code = "shader_type canvas_item;
render_mode blend_mix, unshaded;

uniform float VanishingValue : hint_range(0.0, 1.0);
uniform vec2 Speed;
uniform sampler2D Texture2DParameter : source_color, repeat_enable;



void vertex() {
	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = vec4(0.0);


// Output:0
	COLOR.rgb = vec3(n_out3p0.xyz);


}

void fragment() {
// FloatParameter:8
	float n_out8p0 = VanishingValue;


// Input:6
	float n_out6p0 = TIME;


// Vector2Parameter:7
	vec2 n_out7p0 = Speed;


// VectorOp:5
	vec2 n_out5p0 = vec2(n_out6p0) * n_out7p0;


// UVFunc:4
	vec2 n_in4p1 = vec2(1.00000, 1.00000);
	vec2 n_out4p0 = n_out5p0 * n_in4p1 + UV;


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(Texture2DParameter, n_out4p0);
	float n_out3p1 = n_out3p0.r;


// SmoothStep:9
	float n_in9p1 = 1.00000;
	float n_out9p0 = smoothstep(n_out8p0, n_in9p1, n_out3p1);


// Output:0
	COLOR.rgb = vec3(n_out9p0);


}
"
