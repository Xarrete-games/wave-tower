		{
			"label": "replace-runcontext-node-lookups",
			"type": "shell",
			"command": "powershell",
			"args": [
				"-NoProfile",
				"-Command",
				"$files = Get-ChildItem -Path . -Recurse -Filter *.cs | Select-Object -ExpandProperty FullName; foreach ($f in $files) { $text = Get-Content -Raw -LiteralPath $f; $orig = $text; $text = $text.Replace('GetNode<RunContext>(\"/root/RunContext\")','RunContext.Instance'); $text = $text.Replace('GetNodeOrNull<RunContext>(\"/root/RunContext\")','RunContext.Instance'); $text = $text.Replace('tree?.Root?.GetNodeOrNull<RunContext>(\"/root/RunContext\")','RunContext.Instance'); $text = $text.Replace('(Engine.GetMainLoop() as SceneTree)?.Root.GetNodeOrNull<RunContext>(\"/root/RunContext\")','RunContext.Instance'); $text = $text.Replace('(Engine.GetMainLoop() as SceneTree)?.Root?.GetNodeOrNull<RunContext>(\"/root/RunContext\")','RunContext.Instance'); if ($text -ne $orig) { Set-Content -LiteralPath $f -Value $text -NoNewline } }"
			],
			"problemMatcher": [],
			"group": "build"
		},
